{
  "name": "llm-city",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "lib",
    "tools",
    "web"
  ],
  "scripts": {
    "test": "vitest run",
    "browser:reap": "node tools/src/browser-reap.mjs",
    "prestate": "node tools/src/browser-reap.mjs",
    "pregen:city": "node tools/src/browser-reap.mjs",
    "gen:city": "node web/scripts/gen-city.mjs",
    "preview": "npm run gen:city && npm -w web run dev",
    "build:web": "npm run gen:city && npm -w web run build",
    "gen:plan": "tsx tools/src/gen-plan.ts",
    "inspect": "tsx tools/src/cli.ts inspect",
    "shot": "tsx tools/src/cli.ts shot",
    "demolish": "tsx tools/src/cli.ts demolish",
    "state": "tsx tools/src/cli.ts state",
    "check-history": "tsx tools/src/cli.ts check-history",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
